# ==============================================================================
# THE CONCLAVE — HMS INTEGRATION ENVIRONMENT CONFIGURATION
#
# IMPORTANT SECURITY RULES:
# 1. These variables are for the SERVER-SIDE integration layer ONLY.
# 2. NEVER prefix private secrets with VITE_ (this would bundle them into client browser code).
# 3. Keep private keys secure on your server or hosting provider.
# 4. Never store partner passwords in the website repository.
# ==============================================================================

# Supabase Project URL for HMS WNG SHI
HMS_SUPABASE_URL=https://algorrnjotffcvtinbyy.supabase.co

# Supabase Service Role Key (Server-side ONLY; never expose to frontend)
HMS_SERVICE_ROLE_KEY=

# Homestay ID (UUID) for The Conclave once registered in the HMS `homestays` table
HMS_HOMESTAY_ID=

# Optional: Server port for production Node server
PORT=3000
